NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Логгер: caller-trace и граф-точки включены по умолчанию
# LOG_TRACE=off
# LOG_GRAPHS=off

# Конвенция: имя БД и пользователь = имя проекта.
# Пароль всегда сгенерированный: openssl rand -hex 16
PGHOST=localhost
PGPORT=5432
PGDATABASE=fpsuppliers
PGUSER=fpsuppliers
PGPASSWORD=CHANGE_ME

REDIS_URL=redis://localhost:6379

# Сессии админки: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME

# Origin'ы админки через запятую (пусто — CORS выключен)
CORS_ORIGINS=http://localhost:5173

# Телеграм-бот
TELEGRAM_BOT_TOKEN=CHANGE_ME
BOT_ENABLED=on

# Парсер FunPay
FUNPAY_BASE_URL=https://funpay.com
# Валюта витрины площадки: rub | usd | eur
FUNPAY_CURRENCY=rub
FUNPAY_SYNC_ENABLED=off

# Digiseller (витрина plati.market): официальный публичный API
DIGISELLER_SYNC_ENABLED=off
DIGISELLER_CURRENCY=RUB

# Playerok: данные только через их GraphQL
PLAYEROK_SYNC_ENABLED=off

# Прокси для источников: нужен, если площадка блокирует IP сервера по географии.
# Формат: http://user:pass@host:port. Можно задать общий или отдельный на площадку.
# SOURCE_PROXY_URL=
# PLAYEROK_PROXY_URL=
